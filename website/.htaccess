Options -Indexes
RewriteEngine On

RewriteRule ^(data|templates|migrations)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
RewriteRule .* - [E=BASE:%1]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ %{ENV:BASE}/index.php [L]
